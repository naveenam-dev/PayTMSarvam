# Copy to .env and fill in. Real environment variables override this file.
# Without keys the app still runs fully offline (rules engine + built-in EN/HI/KN replies).

# Google Gemini: complaint understanding + officer summaries
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_THINKING=low

# Sarvam AI: voice agent, speech-to-text, translation, text-to-speech
SARVAM_API_KEY=
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v4-flash
# SARVAM_TTS_SPEAKER=

# Optional alternative LLM (OpenAI-compatible, e.g. NVIDIA NIM), used only if no Gemini key
# LLM_API_KEY=
# LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# LLM_MODEL=meta/llama-3.1-70b-instruct

# Pause between agent steps in the console (seconds), so viewers can follow the reasoning
# SAHAY_STEP_DELAY=0.5
